<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/products">Shop</a>
  <span aria-hidden="true">›</span>
  <a href="/products?category=<%= product.category.slug %>"><%= product.category.name %></a>
  <span aria-hidden="true">›</span>
  <span aria-current="page"><%= product.name %></span>
</nav>

<article class="product-detail">
  <div class="product-detail__media">
    <% if (product.imagePath) { %>
      <img class="product-image" src="<%= product.imagePath %>" alt="<%= product.name %>">
    <% } else { %>
      <span class="product-placeholder product-placeholder--large" aria-hidden="true"><%= product.category.emoji %></span>
    <% } %>
  </div>

  <div class="product-detail__info">
    <h1><%= product.name %></h1>
    <p class="product-detail__price price"><%= formatPrice(product.priceCents) %></p>

    <% if (product.stock === 0) { %>
      <p><span class="pill pill--cherry">Out of stock</span></p>
    <% } else if (product.stock < 5) { %>
      <p><span class="pill pill--butter">Only <%= product.stock %> left!</span></p>
    <% } else { %>
      <p><span class="pill pill--mint">In stock</span></p>
    <% } %>

    <p><%= product.description %></p>

    <div class="product-detail__actions">
      <% if (product.stock > 0) { %>
        <button class="btn btn-primary btn-lg" type="button" disabled title="Coming soon">👜 Add to cart</button>
      <% } %>
      <button class="btn btn-ghost btn-lg" type="button" disabled title="Coming soon" aria-label="Add to wishlist">♡</button>
    </div>

    <% if (product.specs.length > 0) { %>
      <h2>Specifications</h2>
      <table class="specs-table">
        <tbody>
          <% for (const spec of product.specs) { %>
            <tr><th scope="row"><%= spec.key %></th><td><%= spec.value %></td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>

    <h2>Delivery</h2>
    <ul class="delivery-chips">
      <% for (const d of product.deliveryMethods) { %>
        <li class="chip">🚚 <%= d.name %> · <%= formatPrice(d.priceCents) %> · <%= d.eta %></li>
      <% } %>
    </ul>

    <p class="muted">Supplier: <%= product.supplier.name %></p>
  </div>
</article>
