<% if (result.pages > 1) { %>
  <nav class="pagination" aria-label="Pages">
    <% if (result.page > 1) { %>
      <a class="btn btn-soft btn-sm" href="<%= pageUrl(result.page - 1) %>" rel="prev">← Previous</a>
    <% } %>
    <% for (let n = 1; n <= result.pages; n += 1) { %>
      <% if (n === result.page) { %>
        <span class="pagination__current" aria-current="page"><%= n %></span>
      <% } else { %>
        <a class="pagination__link" href="<%= pageUrl(n) %>"><%= n %></a>
      <% } %>
    <% } %>
    <% if (result.page < result.pages) { %>
      <a class="btn btn-soft btn-sm" href="<%= pageUrl(result.page + 1) %>" rel="next">Next →</a>
    <% } %>
  </nav>
<% } %>
