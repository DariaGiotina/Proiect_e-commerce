<% const adminLinks = [
  { href: '/admin', label: 'Dashboard', emoji: '🎀', exact: true },
  { href: '/admin/categories', label: 'Categories', emoji: '🏷️' },
  { href: '/admin/suppliers', label: 'Suppliers', emoji: '🚚' },
  { href: '/admin/delivery-methods', label: 'Delivery methods', emoji: '📦' },
]; %>
<nav class="admin-nav" aria-label="Admin">
  <p class="admin-nav__title">Admin</p>
  <ul>
    <% for (const link of adminLinks) { %>
      <% const active = link.exact ? currentPath === '/admin' || currentPath === '/admin/' : currentPath.startsWith(link.href); %>
      <li>
        <a href="<%= link.href %>" <%- active ? 'aria-current="page"' : '' %>>
          <span aria-hidden="true"><%= link.emoji %></span> <%= link.label %>
        </a>
      </li>
    <% } %>
  </ul>
</nav>
