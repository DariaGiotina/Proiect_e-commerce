<section class="error-page">
  <p class="error-page__emoji" aria-hidden="true"><%= emoji %></p>
  <p class="error-page__status">Error <%= status %></p>
  <h1><%= message %></h1>
  <div class="error-page__actions">
    <a class="btn btn-primary" href="/">Back to the shop</a>
    <a class="btn btn-soft" href="/products">Browse products</a>
  </div>
</section>
